# Proposed defaults, NOT accepted RPO/RTO, SLAs or retention policy.
# Copy outside source to /etc/spina/backup.env mode 0600 after owner choices.
SPINA_BACKUP_ENABLED=no
SPINA_BACKUP_STATE=/var/lib/spina-backup
SPINA_BACKUP_PRIVATE_ROOT=/var/lib/spina/private-evidence
SPINA_BACKUP_CONFIG_ROOT=/etc/spina
SPINA_BACKUP_RELEASE_ROOT=/opt/spina/current
SPINA_BACKUP_CADDY_FILE=/etc/caddy/Caddyfile
SPINA_BACKUP_UNIT_FILE=/etc/systemd/system/spina-api.service
SPINA_BACKUP_HOST=spina-production
SPINA_BACKUP_SERVICE=spina-api
SPINA_BACKUP_LOCK=/opt/spina/deployment.lock
SPINA_BACKUP_KEEP_DAILY=7
SPINA_BACKUP_KEEP_WEEKLY=4
SPINA_BACKUP_KEEP_MONTHLY=3
SPINA_BACKUP_RETENTION_ENABLED=no
# Selected PC workflow: encrypted server staging, copied to the PC over pinned SSH.
# Initialize this DEDICATED repository explicitly; the wrapper never creates it.
RESTIC_REPOSITORY=/var/lib/spina-backup/repository
# Keep key OUTSIDE all captured paths and escrow independently of host/PC.
RESTIC_PASSWORD_FILE=/root/spina-backup-source-password
RESTIC_CACHE_DIR=/var/cache/spina-restic
PGHOST=
PGPORT=5432
PGDATABASE=postgres
PGUSER=
PGSSLMODE=verify-full
PGSSLROOTCERT=
PGPASSFILE=/root/spina-backup.pgpass
PGCONNECT_TIMEOUT=10
