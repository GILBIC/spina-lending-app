# Proposed thresholds only; owner must accept operational budget and recipient.
SPINA_MONITOR_PUBLIC_URL=https://api.spina.com.ph/health/ready
SPINA_BACKUP_STATE=/var/lib/spina-backup
SPINA_MONITOR_STATE=/var/lib/spina-monitor
SPINA_MONITOR_DISK_PERCENT=85
SPINA_MONITOR_BACKUP_MAX_HOURS=30
SPINA_MONITOR_PC_BACKUP_REQUIRED=yes
SPINA_MONITOR_5XX_COUNT=3
SPINA_MONITOR_5XX_RATE=0.05
SPINA_ALERT_ENABLED=no
SPINA_ALERT_FROM=
SPINA_ALERT_TO=
SPINA_ALERT_SMTP_HOST=
SPINA_ALERT_SMTP_PORT=587
SPINA_ALERT_SMTP_MODE=starttls
SPINA_ALERT_SMTP_USER=
SPINA_ALERT_SMTP_PASSWORD=
