        "kind": "return",
        "result": null,
        "styles": [
          {
            "configure_calls": [
              {
                "style": "ModernDash.Treeview",
                "kwargs": {
                  "rowheight": 30,
                  "font": [
                    "Segoe UI",
                    10
                  ],
                  "background": "dash-panel",
                  "fieldbackground": "dash-panel",
                  "foreground": "dash-fg",
                  "borderwidth": 0
                }
              },
              {
                "style": "ModernDash.Treeview.Heading",
                "kwargs": {
                  "font": [
                    "Segoe UI",
                    10,
                    "bold"
                  ],
                  "background": "dash-card2",
                  "foreground": "dash-fg",
                  "relief": "flat"
                }
              }
            ],
            "map_calls": [
              {
                "style": "ModernDash.Treeview",
                "kwargs": {
                  "background": [
                    [
                      "selected",
                      "dash-accent"
                    ]
                  ]
                }
              }
            ]
          }
        ]
      },
