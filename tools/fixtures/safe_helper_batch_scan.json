        "source": "def join_area_main_sub(main_area: str, sub_area: str = \"\") -> str:\n    \"\"\"Join main/sub into a single Area string using a consistent separator.\n\n    - If sub_area is blank -> returns main_area\n    - Else -> 'Main - Sub'\n    \"\"\"\n    try:\n        ma = str(main_area or \"\").strip()\n    except Exception:\n        ma = \"\"\n    try:\n        su = str(sub_area or \"\").strip()\n    except Exception:\n        su = \"\"\n    if not ma:\n        return su\n    if not su:\n        return ma\n    return f\"{ma} - {su}\""
