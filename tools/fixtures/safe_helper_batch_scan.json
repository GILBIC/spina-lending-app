        "source": "def _spina_crc_wrap(c, text, width, font=\"Helvetica\", size=8.0):\n    try:\n        words = str(text or \"\").split()\n    except Exception:\n        words = []\n    if not words:\n        return [\"\"]\n    lines = []\n    cur = \"\"\n    for w in words:\n        test = (cur + \" \" + w).strip()\n        try:\n            ok = c.stringWidth(test, font, size) <= width\n        except Exception:\n            ok = len(test) * size * 0.5 <= width\n        if ok or not cur:\n            cur = test\n        else:\n            lines.append(cur)\n            cur = w\n    if cur:\n        lines.append(cur)\n    return lines or [\"\"]"
      }
    ]
