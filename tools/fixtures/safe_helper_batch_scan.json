        "source": "def _spina_crc_clean_reason(_v):\n    try:\n        s = str(_v or \"\").strip()\n    except Exception:\n        s = \"\"\n    if not s:\n        return \"\"\n    try:\n        s = re.sub(r\"\\[RC:[^\\]]+\\]\", \"\", s, flags=re.I).strip()\n        s = re.sub(r\"\\[ADV:[^\\]]+\\]\", \"\", s, flags=re.I).strip()\n        s = re.sub(r\"\\s+\", \" \", s).strip()\n    except Exception:\n        pass\n    return s"
