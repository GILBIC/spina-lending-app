        "source": "def _spina__norm_weekday(_v):\n    try:\n        _s = str(_v or '').strip()\n    except Exception:\n        _s = ''\n    if not _s:\n        return ''\n    _k = _s[:3].lower()\n    _mp = {\n        'mon': 'Mon', 'tue': 'Tue', 'wed': 'Wed', 'thu': 'Thu',\n        'fri': 'Fri', 'sat': 'Sat', 'sun': 'Sun'\n    }\n    return _mp.get(_k, '')"
