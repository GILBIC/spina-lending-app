{
  "target": "_spina_cilog_diff_pairs",
  "case_names": [
    "both_none",
    "new_dict_from_none",
    "old_dict_to_none",
    "scalar_change",
    "scalar_same",
    "mixed_dict_scalar",
    "empty_dicts",
    "id_only_change",
    "changed_fields_sorted",
    "added_removed",
    "nested_change",
    "list_change",
    "boolean_numeric_equal",
    "none_field_change"
  ],
  "behavior": {
    "both_none": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[]"
    },
    "new_dict_from_none": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('a', None, 1), ('b', None, 2), ('id', None, 99)]"
    },
    "old_dict_to_none": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('a', 1, None), ('b', 2, None), ('id', 99, None)]"
    },
    "scalar_change": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('Value', 'old', 'new')]"
    },
    "scalar_same": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[]"
    },
    "mixed_dict_scalar": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('Value', {'a': 1}, 'value')]"
    },
    "empty_dicts": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[]"
    },
    "id_only_change": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[]"
    },
    "changed_fields_sorted": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('a', 1, 3), ('b', 1, 2)]"
    },
    "added_removed": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('add', None, 7), ('remove', 9, None)]"
    },
    "nested_change": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('meta', {'x': 1}, {'x': 2})]"
    },
    "list_change": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('items', [1, 2], [1, 3])]"
    },
    "boolean_numeric_equal": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[]"
    },
    "none_field_change": {
      "kind": "return",
      "type": "builtins.list",
      "repr": "[('a', None, 0)]"
    }
  }
}
